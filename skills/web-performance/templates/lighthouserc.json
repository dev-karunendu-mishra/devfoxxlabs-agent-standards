{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/REPLACE-listing-page",
        "http://localhost:3000/REPLACE-detail-page"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "perf",
        "formFactor": "mobile",
        "throttlingMethod": "simulate"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],
        "server-response-time": ["warn", { "maxNumericValue": 800 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 174080 }],
        "resource-summary:total:size": ["warn", { "maxNumericValue": 1572864 }],
        "resource-summary:third-party:count": ["warn", { "maxNumericValue": 0 }],
        "unsized-images": "error",
        "lcp-lazy-loaded": "error",
        "render-blocking-resources": "warn",
        "uses-responsive-images": "warn",
        "modern-image-formats": "warn"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
